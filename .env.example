# Copy to .env and fill in. Never commit the real file -- .gitignore covers it.

# From the App's settings page at github.com/settings/apps/contractor-access-expiry
GITHUB_APP_ID=4716146

# Path to the .pem you download from that page. Keep it outside this repo.
GITHUB_PRIVATE_KEY_PATH=/path/to/your/private-key.pem

# The webhook secret you set on the App's page. Must match exactly.
GITHUB_WEBHOOK_SECRET=

# Local runs only. On Fly this is set to /data/cae.db by fly.toml.
CAE_DB=data/cae.db

# Required to view /gate. Unset means the page is disabled.
GATE_TOKEN=
